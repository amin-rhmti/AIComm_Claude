label var Post_personal_anecdote "Score 0/1/2 for personal anecdotes (explicit/implicit first-person experience/story: I/me/my, my friends/family, at our university, etc.). 0 = none."
label var Post_emotional_appeal "Score 0/1/2 for emotional appeal (explicit/implicit emotions like fear/anger/hope/sadness/anxiety/guilt; dramatic wording to evoke strong feelings about climate change)."
label var Post_scientific_argument "Score 0/1/2 for scientific arguments (statistics, data-driven claims, referring to a study, methodological/structured reasoning). 0 = none."
label var Post_moral_narratives "Score 0/1/2 for moral narratives (right/wrong, duty, justice, fairness, ethical responsibility, moral judgments). 0 = none."
label var Post_causal_narratives "Score 0/1/2 for causal narratives (cause-effect/mechanisms; A causes/results in B; explanatory structure). 0 = none."
label var Post_meaningfulness "Meaningfulness (0/1): 1 if coherent and on-topic to climate/environment/impacts (any well-formed reflection/opinion/description counts); 0 only if empty/gibberish/unrelated (jokes/spam)."
label var Post_typos_count "Count total typos (misspelled words, transposed/omitted letters, missing spaces, repeated words; exclude intentional informal spellings like 'u', 'gonna'). Return an integer count."
label var Post_pangram_headline  "Pangram AI detection headline"
label var Post_fraction_ai  "The proportion of the text that Pangram classifies as fully AI-generated."
label var Post_fraction_ai_assisted  "The proportion classified as AI-assisted: text where a human likely used AI to help refine, rewrite, or polish their own writing (a co-authoring signal)."
label var Post_fraction_human "The proportion of the text that Pangram classifies as fully human-generated."
