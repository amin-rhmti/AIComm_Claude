ce your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\tjQuery(\"#\"+this.questionId+\" .InputText:eq(0)\").on(\"cut copy paste\",function(e) {\n   e.preventDefault();\n  });\n\t\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"ExplainControl","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"We will ask you on the next page to write a post, similar to what you would write on social media...","DisplayLogic":{"0":{"0":{"LogicType":"EmbeddedField","LeftOperand":"TreatIdentity","Operator":"EqualTo","RightOperand":"2","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span>  <span class=\"LeftOpDesc\">TreatIdentity<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 2 <\/span>"},"1":{"LogicType":"EmbeddedField","LeftOperand":"TreatComp","Operator":"EqualTo","RightOperand":"1","Type":"Expression","Description":"<span class=\"ConjDesc\">And<\/span>  <span class=\"LeftOpDesc\">TreatComp<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 1 <\/span>","Conjuction":"And"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID107"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID108","SecondaryAttribute":"We will ask you on the next page to write a post, similar to what you would write on social media...","TertiaryAttribute":null,"Payload":{"QuestionText":"We will ask you on the next page to write a post, similar to what you would write on social media, on the following topic:<br \/>\n<br \/>\n<strong>Why is it important to donate to charitable organizations, causes, or individuals in need?<\/strong><br \/>\n<br \/>\n<strong>The post will be sent to three recipients consisting of three Prolific participants. <\/strong>Each recipient will independently have the opportunity to react and reply to your post. You will be notified of those reactions and replies by Prolific message.<br \/>\n<br \/>\nThe message sent to the recipient will look as follows:<br \/>\n<br \/>\nA participant (aged ${q:\/\/QID1216739351\/ChoiceTextEntryValue}, ${q:\/\/QID1216739355\/ChoiceGroup\/SelectedChoices}) from ${q:\/\/QID1216739363\/ChoiceTextEntryValue} wrote the following post<br \/>\n<img src=\"${q:\/\/QID77\/UploadedFileLink}\" \/><br \/>\n<br \/>\n&nbsp;\n<div style=\"text-align: center;\">[your post here]<\/div>\n<br \/>\n<br \/>\n<br \/>\nWhich of the following emojis would you react with if you saw this post on your social media timeline, if any?<br \/>\nLike<br \/>\nLove<br \/>\nCare<br \/>\nHaha<br \/>\nWow<br \/>\nSad<br \/>\nAngry<br \/>\nI would not react to this post.<br \/>\n<br \/>\nIf you feel inclined to respond, what would your reply be? Please write your response below as you would post it on social media.","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\tjQuery(\"#\"+this.questionId+\" .InputText:eq(0)\").on(\"cut copy paste\",function(e) {\n   e.preventDefault();\n  });\n\t\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"ExplainControl1","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"We will ask you on the next page to write a post, similar to what you would write on social media...","DisplayLogic":{"0":{"0":{"LogicType":"EmbeddedField","LeftOperand":"TreatIdentity","Operator":"EqualTo","RightOperand":"2","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span>  <span class=\"LeftOpDesc\">TreatIdentity<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 2 <\/span>"},"1":{"LogicType":"EmbeddedField","LeftOperand":"TreatComp","Operator":"EqualTo","RightOperand":"1","Type":"Expression","Description":"<span class=\"ConjDesc\">And<\/span>  <span class=\"LeftOpDesc\">TreatComp<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 1 <\/span>","Conjuction":"And"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID108"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID109","SecondaryAttribute":"${e:\/\/Field\/AdjustInstruct} ${e:\/\/Field\/WritingTaskInstruct} Write a post, similar to what you wo...","TertiaryAttribute":null,"Payload":{"QuestionText":"${e:\/\/Field\/AdjustInstruct}<br \/>\n<br \/>\n${e:\/\/Field\/WritingTaskInstruct}<br \/>\n<br \/>\nWrite a post, similar to what you would write on social media, on the following topic:<br \/>\n<br \/>\n<strong>${e:\/\/Field\/WritingTaskPrompt}<\/strong><br \/>\n<br \/>\nPlease complete this task in one session and avoid switching to other browser tabs, windows, or engaging in other activities until you finish.","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\tjQuery(\"#\"+this.questionId+\" .InputText:eq(0)\").on(\"cut copy paste\",function(e) {\n   e.preventDefault();\n  });\n\t\n    \/*popupCounter is a variable that keeps track of the number of times*\/ \n    \/*the subject leaves the page*\/\n    var popupCounter = 0;\n    \/*totalTimeOffPage is a variable that keeps track of the total number of *\/ \n    \/*milliseconds the subject spends away from the page*\/ \n    var totalTimeOffPage = 0;\n\n    \/*window.onblur is triggered whenever the subject leaves the page, but *\/\n    \/*IS ONLY triggered TRIGGERED AFTER THE SUBJECT INTERACTS WITH THE PAGE *\/\n    \/*AT LEAST ONCE*\/ \n    window.onblur = function() {\n        \/*this start variable captures the current system time on the*\/ \n        \/*subject's machine*\/ \n        var start = new Date(); \n        \/*if the subject has not yet received a popup, then a popup is *\/\n        \/*triggered warning the subject not to leave the page*\/ \n        if (popupCounter < 1) {     \n        \/*You can set whatever alert message you want inside the parentheses*\/\n        \/*below*\/ \n            alert(\"Please don't leave this until it is complete!\"); \n        }\n        \/*the popupCounter is incremented each time the participant leaves*\/\n        \/*the page*\/ \n        popupCounter ++;  \n        \/*each time the popupCounter is incremented, the Embedded Data value*\/ \n        \/*\"numLeaves\" is updated with the new total number of leaves*\/ \n        Qualtrics.SurveyEngine.setEmbeddedData('numLeaves', popupCounter);\n\n        \/*when the subject returns to the page, the window.onfocus function is*\/\n        \/*triggered*\/ \n        window.onfocus = function() {\n            \/*the end variable captures the current system time on the *\/\n            \/*subject's machine*\/ \n            var end = new Date(); \n            \/*blipTime calculates the total number of MILLISECONDS that*\/\n            \/*passed between the most recent onblur event, and subsequent*\/\n            \/*onfocus event*\/ \n            blipTime = end - start;\n            \/*blipTime is added to the running total time off page in*\/\n            \/*the variable totalTimeOffPage*\/\n            totalTimeOffPage = totalTimeOffPage + blipTime; \n            \/*the Embedded Data value totalTimeOff is updated to reflect*\/\n            \/*the current running total of time off the page*\/ \n            Qualtrics.SurveyEngine.setEmbeddedData('totalTimeOff', totalTimeOffPage);\n        }\n    }\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"WritingTask","QuestionID":"QID109","QuestionType":"TE","Selector":"ESTB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"${e:\/\/Field\/AdjustInstruct} ${e:\/\/Field\/WritingTaskInstruct} Write a post, similar to what you wo...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None","MinChars":"1"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID110","SecondaryAttribute":"Please write a post, similar to what you would write on social media, on the following topic: Why...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please write a post, similar to what you would write on social media, on the following topic:<br \/>\n<br \/>\n<strong>Why is it important to donate to charitable organizations, causes, or individuals in need?<\/strong><br \/>\n<br \/>\n<strong>The post will be sent to three recipients consisting of three Prolific participants. <\/strong>Each recipient will independently have the opportunity to react and reply to your post. You will be notified of those reactions and replies by Prolific message.<br \/>\n<br \/>\nThe message sent to the recipient will look as follows:<br \/>\n<br \/>\nA participant (aged ${q:\/\/QID1216739351\/ChoiceTextEntryValue}, ${q:\/\/QID1216739355\/ChoiceGroup\/SelectedChoices}) from ${q:\/\/QID1216739363\/ChoiceTextEntryValue} wrote the following post<br \/>\n<img src=\"${q:\/\/QID77\/UploadedFileLink}\" \/><br \/>\n<br \/>\n&nbsp;\n<div style=\"text-align: center;\">[your post here]<\/div>\n<br \/>\n<br \/>\n<br \/>\nWhich of the following emojis would you react with if you saw this post on your social media timeline, if any?<br \/>\nLike<br \/>\nLove<br \/>\nCare<br \/>\nHaha<br \/>\nWow<br \/>\nSad<br \/>\nAngry<br \/>\nI would not react to this post.<br \/>\n<br \/>\nIf you feel inclined to respond, what would your reply be? Please write your response below as you would post it on social media.","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\tjQuery(\"#\"+this.questionId+\" .InputText:eq(0)\").on(\"cut copy paste\",function(e) {\n   e.preventDefault();\n  });\n\t\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"WritingControl1","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please write a post, similar to what you would write on social media, on the following topic: Why...","DisplayLogic":{"0":{"0":{"LogicType":"EmbeddedField","LeftOperand":"TreatIdentity","Operator":"EqualTo","RightOperand":"2","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span>  <span class=\"LeftOpDesc\">TreatIdentity<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 2 <\/span>"},"1":{"LogicType":"EmbeddedField","LeftOperand":"TreatComp","Operator":"EqualTo","RightOperand":"1","Type":"Expression","Description":"<span class=\"ConjDesc\">And<\/span>  <span class=\"LeftOpDesc\">TreatComp<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 1 <\/span>","Conjuction":"And"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID110"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID111","SecondaryAttribute":"You now have a chance to earn a bonus payment in an optional task. In this task, you will draft a...","TertiaryAttribute":null,"Payload":{"QuestionText":"You now have a chance to earn a bonus payment in an optional task. In this task, you will draft a message intended for a climate-conscious student in Zurich.<br>\n<br>\nThe recipient will carefully read your message and then guess whether you, the author, made a donation to address climate change in the earlier survey question.&nbsp;<br>\n<br>\nThe recipient will view one message randomly chosen from a pool of three, including yours and two others written by <strong>${e:\/\/Field\/TreatCompOthers},<\/strong> but they will not be told who wrote which message. <strong>${e:\/\/Field\/ProbExplain}<\/strong><br>\n<br>\n${e:\/\/Field\/GenAIAction} ${e:\/\/Field\/BotAction} <strong>${e:\/\/Field\/OneBotMessage} <\/strong>${e:\/\/Field\/RecipientInfo}<br>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\tjQuery(\"#\"+this.questionId+\" .InputText:eq(0)\").on(\"cut copy paste\",function(e) {\n   e.preventDefault();\n  });\n\t\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"ExplainTask1","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You now have a chance to earn a bonus payment in an optional task. In this task, you will draft a...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,