ocus = function() {\n            \/*the end variable captures the current system time on the *\/\n            \/*subject's machine*\/ \n            var end = new Date(); \n            \/*blipTime calculates the total number of MILLISECONDS that*\/\n            \/*passed between the most recent onblur event, and subsequent*\/\n            \/*onfocus event*\/ \n            blipTime = end - start;\n            \/*blipTime is added to the running total time off page in*\/\n            \/*the variable totalTimeOffPage*\/\n            totalTimeOffPage = totalTimeOffPage + blipTime; \n            \/*the Embedded Data value totalTimeOff is updated to reflect*\/\n            \/*the current running total of time off the page*\/ \n            Qualtrics.SurveyEngine.setEmbeddedData('totalTimeOff', totalTimeOffPage);\n        }\n    }\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"${e:\/\/Field\/AdjustInstruct} ${e:\/\/Field\/WritingTaskInstruct} Earlier, you wrote: ...","Choices":{"7":{"Display":"Yes, I would like to adjust my response"},"8":{"Display":"No, I would like to use the same response as before"}},"ChoiceOrder":["7","8"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":1,"QuestionText_Unsafe":"${e:\/\/Field\/AdjustInstruct}<br><br>\n${e:\/\/Field\/WritingTaskInstruct}<br><br>Would you like to adjust your response?<br>","DataExportTag":"WritingAdjustCharity","QuestionID":"QID181"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID182","SecondaryAttribute":"Here is a potential social media post: Some of us start closer to the finish line than others. So...","TertiaryAttribute":null,"Payload":{"QuestionText":"Here is a potential social media post<strong>:<\/strong><br>\n<br><i>\nSome of us start closer to the finish line than others. Some individuals need a boost to get their lives back on track. It feels good to give when you are fortunate to have enough. Let's all do our part and donate to things that matter to us.<br><\/i><br>How would you react if you saw this post on your social media timeline?<br>","DataExportTag":"PostReact","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Here is a potential social media post: Some of us start closer to the finish line than others. So...","Choices":{"1":{"Display":"Like"},"2":{"Display":"Dislike"},"3":{"Display":"I would not react to this post"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID182"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID183","SecondaryAttribute":"Without having viewed the message, what do you think is the probability that the recipient will g...","TertiaryAttribute":null,"Payload":{"QuestionText":"Without having viewed the message, what do you think is the probability that the recipient will guess the author of the message has made an actual donation to address climate change?<br>","DefaultChoices":false,"DataExportTag":"BeliefPrior ","QuestionID":"QID183","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":true,"NumDecimals":"0","ShowValue":true,"CustomStart":true,"NotApplicable":false,"MobileFirst":true,"SliderStartPositions":{"1":0}},"QuestionDescription":"Without having viewed the message, what do you think is the probability that the recipient will g...","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"Labels":[],"Answers":{"1":{"Display":0},"2":{"Display":10},"3":{"Display":20},"4":{"Display":30},"5":{"Display":40},"6":{"Display":50},"7":{"Display":60},"8":{"Display":70},"9":{"Display":80},"10":{"Display":90},"11":{"Display":100}}}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID184","SecondaryAttribute":"We have the following default message that you can send to the recipient: Default message: Addres...","TertiaryAttribute":null,"Payload":{"QuestionText":"We have the following default message that you can send to the recipient:<br>\n<br>\nDefault message: <em>Addressing climate change is an important global issue, and it is great to see countries starting to collaborate on it. We are doing our part to help with it too. However, while addressing climate change is important, we have other important local issues to focus on. Improving healthcare, reducing health insurance premiums and financing retirement provisions deserve our attention, too.<\/em><br>\n<br>\nFor a cost of CHF<strong>${e:\/\/Field\/WritingCost}<\/strong>, you have the option to send a Custom message:\n<ul>\n\t<li><em>If we are in a spot to contribute to charity, the impacts we make can last a lifetime and impact generations to come. As of now, addressing climate change is the most important thing any of us could do. If we are in a place to donate, putting our money towards charities that help take care of the planet will impact future generations of children and animals. <\/em><\/li>\n<\/ul>\n\n<p dir=\"ltr\"><br>\nYour final bonus payment will be calculated as follows:<\/p>\n\n<ul>\n\t<li>To compensate for your time, the<strong> base payment<\/strong> for completing this optional task is<strong>&nbsp;<\/strong>CHF<strong>${e:\/\/Field\/BasePay}.<\/strong>&nbsp;<\/li>\n\t<li>If you choose to send the customized message, CHF<strong>${e:\/\/Field\/WritingCost}<\/strong> will be <b>deducted&nbsp;<\/b>from your base payment.<\/li>\n\t<li>If the recipient believes that you made a donation&nbsp;to address&nbsp;climate change, CHF<strong>${e:\/\/Field\/BonusPay}<\/strong> will be <strong>added<\/strong> to your base payment.<\/li>\n<\/ul>\n<br>\nThe recipient does not know that their response may result in a bonus for you. <br><br>\nReminder:&nbsp;${e:\/\/Field\/ProbExplain}","DefaultChoices":false,"DataExportTag":"ExplainTask2","QuestionID":"QID184","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"We have the following default message that you can send to the recipient: Default message: Addres...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID185","SecondaryAttribute":"Which of the following messages would you like to send? Default message: Addressing climate chang...","TertiaryAttribute":null,"Payload":{"QuestionText":"Which of the following messages would you like to send?\n<ul>\n\t<li>Default message: <em>Addressing climate change is an important global issue, and it is great to see countries starting to collaborate on it. We are doing our part to help with it too. However, while addressing climate change is important, we have other important local issues to focus on. Improving healthcare, reducing health insurance premiums and financing retirement provisions deserve our attention, too<\/em><\/li>\n\t<li>Custom message: <em>If we are in a spot to contribute to charity, the impacts we make can last a lifetime and impact generations to come. As of now, addressing climate change is the most important thing any of us could do. If we are in a place to donate, putting our money towards charities that help take care of the planet will impact future generations of children and animals. <\/em>\u200b\u200b\u200b\u200b\u200b\u200b<\/li>\n<\/ul>\nAs a reminder, if you choose the custom message, CHF<strong>${e:\/\/Field\/WritingCost}<\/strong> will be <strong>deducted<\/strong> from your base payment.&nbsp;If the recipient believes that you made a donation to address climate change, CHF<strong>${e:\/\/Field\/BonusPay}<\/strong> will be <strong>added <\/strong>to your base payment.","DataExportTag":"MessageChoice","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which of the following messages would you like to send? Default message: Addressing climate chang...","Choices":{"1":{"Display":"Default message"},"2":{"Display":"Custom"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID185"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID186","SecondaryAttribute":"Please write the message you'd like to share with the recipient:","TertiaryAttribute":null,"Payload":{"QuestionText":"Please write the message you'd like to share with the recipient:<br>","DefaultChoices":false,"DataExportTag":"CreateMessage","QuestionID":"QID186","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please write the message you'd like to share with the recipient:","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\tjQuery(\"#\"+this.questionId+\" .InputText:eq(0)\").on(\"cut copy paste\",function(e) {\n   e.preventDefault();\n  });\n\t\n    \/*popupCounter is a variable that keeps track of the number of times*\/ \n    \/*the subject leaves the page*\/\n    var popupCounter = 0;\n    \/*totalTimeOffPage is a variable that keeps track of the total number of *\/ \n    \/*milliseconds the subject spends away from the page*\/ \n    var totalTimeOffPage = 0;\n\n    \/*window.onblur is triggered whenever the subject leaves the page, but *\/\n    \/*IS ONLY triggered TRIGGERED AFTER THE SUBJECT INTERACTS WITH THE PAGE *\/\n    \/*AT LEAST ONCE*\/ \n    window.onblur = function() {\n        \/*this start variable captures the current system time on the*\/ \n        \/*subject's machine*\/ \n        var start = new Date(); \n        \/*if the subject has not yet received a popup, then a popup is *\/\n        \/*triggered warning the subject not to leave the page*\/ \n        if (popupCounter < 1) {     \n        \/*You can set whatever alert message you want inside the parentheses*\/\n        \/*below*\/ \n            alert(\"Please don't leave this until it is complete!\"); \n        }\n        \/*the popupCounter is incremented each time the participant leaves*\/\n        \/*the page*\/ \n        popupCounter ++;  \n        \/*each time the popupCounter is incremented, the Embedded Data value*\/ \n        \/*\"numLeaves\" is updated with the new total number of leaves*\/ \n        Qualtrics.SurveyEngine.setEmbeddedData('numLeaves', popupCounter);\n\n        \/*when the subject returns to the page, the window.onfocus function is*\/\n        \/*triggered*\/ \n        window.onfocus = function() {\n            \/*the end variable captures the current system time on the *\/\n            \/*subject's machine*\/ \n            var end = new Date(); \n            \/*blipTime calculates the total number of MILLISECONDS that*\/\n            \/*passed between the most recent onblur event, and subsequent*\/\n            \/*onfocus event*\/ \n            blipTime = end - start;\n            \/*blipTime is added to the running total time off page in*\/\n            \/*the variable totalTimeOffPage*\/\n            totalTimeOffPage = totalTimeOffPage + blipTime; \n            \/*the Embedded Data value totalTimeOff is updated to reflect*\/\n            \/*the current running total of time off the page*\/ \n            Qualtrics.SurveyEngine.setEmbeddedData('totalTimeOff', totalTimeOffPage);\n        }\n    }\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID187","SecondaryAttribute":"After having viewed your message, what do you think is the probability that the recipient will gu...","TertiaryAttribute":null,"Payload":{"QuestionText":"After having viewed your message, what do you think is the probability that the recipient will guess the author of the message has made an actual donation to address climate change?<br>","DefaultChoices":false,"DataExportTag":"BeliefPosterior","QuestionID":"QID187","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":true,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"After having viewed your message, what do you think is the probability that the recipient will gu...","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"Labels":[],"Answers":{"1":{"Display":0},"2":{"Display":10},"3":{"Display":20},"4":{"Display":30},"5":{"Display":40},"6":{"Display":50},"7":{"Display":60},"8":{"Display":70},"9":{"Display":80},"10":{"Display":90},"11":{"Display":100}}}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID188","SecondaryAttribute":"Relative to climate-conscious ETH\/UZH students, do you think Gen-AI bots are more or less effecti...","TertiaryAttribute":null,"Payload":{"QuestionText":"Relative to climate-conscious ETH\/UZH students, do you think Gen-AI bots are more or less effective at convincing the recipient that they donated to addressing climate change?","DataExportTag":"GenAIEffective","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Relative to climate-conscious ETH\/UZH students, do you think Gen-AI bots are more or less effecti...","Choices":{"1":{"Display":"More effective"},"2":{"Display":"Equally effective"},"3":{"Display":"Less effective"},"4":{"Display":"Unsure"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID188"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID189","SecondaryAttribute":"Relative to climate-conscious ETH\/UZH students, do you think rule-based bots are more or less eff...","TertiaryAttribute":null,"Payload":{"QuestionText":"Relative to climate-conscious ETH\/UZH students, do you think rule-based bots are more or less effective at convincing the recipient that they donated to addressing climate change?\n <br>","DataExportTag":"BotEffective","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Relative to climate-conscious ETH\/UZH students, do you think rule-based bots are more or less eff...","Choices":{"1":{"Display":"More effective"},"2":{"Display":"Equally effective"},"3":{"Display":"Less effective"},"4":{"Display":"Unsure"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID189"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID190","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"TrackInstruction2","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":60,"NextAnswerId":1,"QuestionID":"QID190"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID191","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DataExportTag":"Q191","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID191"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID192","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DataExportTag":"Q192","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID192"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID193","SecondaryAttribute":"What is the probability that a bot sender makes a donation to address climate change?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is the probability that a bot sender makes a donation to address climate change?","DefaultChoices":false,"DataExportTag":"AttnChckBot","QuestionID":"QID193","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":true,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true,"SliderStartPositions":{"1":0}},"QuestionDescription":"What is the probability that a bot sender makes a donation to address climate change?","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"Labels":[],"Answers":{"1":{"Display":0},"2":{"Display":10},"3":{"Display":20},"4":{"Display":30},"5":{"Display":40},"6":{"Display":50},"7":{"Display":60},"8":{"Display":70},"9":{"Display":80},"10":{"Display":90},"11":{"Display":100}}}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID194","SecondaryAttribute":"What is the probability that a bot sender makes a donation?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is the probability that a bot sender makes a donation?","DefaultChoices":false,"DataExportTag":"Q197","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":true,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"What is the probability that a bot sender makes a donation?","Choices":{"1":{"Display":"Probability that bot donates"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"Labels":[],"Answers":{"1":{"Display":0},"2":{"Display":10},"3":{"Display":20},"4":{"Display":30},"5":{"Display":40},"6":{"Display":50},"7":{"Display":60},"8":{"Display":70},"9":{"Display":80},"10":{"Display":90},"11":{"Display":100}},"QuestionID":"QID194"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID195","SecondaryAttribute":"To ensure the validity of our research, it's important that you thoroughly read and understand th...","TertiaryAttribute":null,"Payload":{"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"AttnChckRandom","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":6,"QuestionDescription":"To ensure the validity of our research, it's important that you thoroughly read and understand th...","QuestionID":"QID195","QuestionText":"To ensure the validity of our research, it's important that you thoroughly read and understand the directions provided. Your comprehension directly affects the integrity of the data we collect. To confirm that you have read the instructions, please answer the following question:\n\nThe recipient will view one message randomly selected from a pool of three, including your message and two others. <br><br>Out of these three posts, how many are written by humans?","QuestionText_Unsafe":"In order to facilitate our research, we are interested in knowing certain factors about you. Specifically, we are interested in whether you actually take the time to read the directions; if not, then the data we collect based on your responses will be invalid. So, in order to demonstrate that you have read the instructions, please answer the following question:<br><br>The recipient will view one post randomly chosen from a pool of five posts. How many of these posts are written by humans?\n<br>","QuestionType":"TE","SearchSource":{"AllowFreeResponse":"false"},"Selector":"SL","Validation":{"Settings":{"ForceResponse":"OFF","Type":"ContentType","MinChars":"1","ContentType":"ValidNumber","ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip","ValidNumber":{"Min":"0","Max":"100","NumDecimals":""}}}}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID196","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionText_Unsafe":"Timing","DataExportTag":"Q196","QuestionID":"QID196"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID197","SecondaryAttribute":"In the next few questions, you will read and respond to posts that may have been written by human...","TertiaryAttribute":null,"Payload":{"QuestionText":"In the next few questions, you will read and respond to posts that may have been written by humans, traditional rule-based bots, or conversational Gen-AI bots. Please note that all posts written by humans were created without any AI assistance. <br><br>Here is a potential social media post, drawn from a pool of four posts from <b>4 climate-conscious humans:<\/b><br>\n<br>\n<em>${e:\/\/Field\/ReadingPost1}<\/em><br>\n<br>\nHow would you react if you saw this post on your social media timeline?<br>","DefaultChoices":false,"DataExportTag":"ReadingReact1 ","QuestionID":"QID197","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, you will read and respond to posts that may have been written by human...","Choices":{"4":{"Display":"Like"},"5":{"Display":"Dislike"},"6":{"Display":"I would not react to this post"}},"ChoiceOrder":["4","5","6"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID198","SecondaryAttribute":"How familiar are you with ChatGPT and other Gen-AI bots?","TertiaryAttribute":null,"Payload":{"QuestionText":"How familiar are you with ChatGPT and other Gen-AI bots?<br>","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How familiar are you with ChatGPT and other Gen-AI bots?","Choices":{"1":{"Display":"I am very familiar and use them frequently"},"2":{"Display":"I am somewhat familiar and use them occasionally"},"3":{"Display":"I am somewhat familiar but rarely use them"},"4":{"Display":"I am aware of them but do not use them"},"5":{"Display":"I am not familiar with them at all"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"