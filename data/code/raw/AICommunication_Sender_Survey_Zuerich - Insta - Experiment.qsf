W3DbYd0UHrg","description":"Validation Failed"}}}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID246"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID247","SecondaryAttribute":"To what extent do you feel a personal responsibility to try to reduce climate change?","TertiaryAttribute":null,"Payload":{"QuestionText":"To what extent do you feel a personal responsibility to try to reduce climate change?","DataExportTag":"ClimatePersonal","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"To what extent do you feel a personal responsibility to try to reduce climate change?","Choices":{"1":{"Display":"Not at all responsible"},"4":{"Display":"Slightly responsible"},"5":{"Display":"Moderately responsible"},"6":{"Display":"Very responsible"},"7":{"Display":"Extremely responsible"}},"ChoiceOrder":["1","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID247"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID248","SecondaryAttribute":"How worried are you about climate change?","TertiaryAttribute":null,"Payload":{"QuestionText":"How worried are you about climate change? <br>","DataExportTag":"ClimateWorry","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How worried are you about climate change?","Choices":{"1":{"Display":"Not at all worried"},"4":{"Display":"Not very worried"},"5":{"Display":"Moderately worried"},"6":{"Display":"Very worried"},"7":{"Display":"Extremely worried"}},"ChoiceOrder":["1","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID248"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID249","SecondaryAttribute":"We have two writing tasks for you. For the first task, we invite you to write a post on the follo...","TertiaryAttribute":null,"Payload":{"QuestionText":"We have two writing tasks for you.<br>\n<br>\nFor the first task, we invite you to write a post on the following topic:&nbsp;<br>\n<br>\n<strong>Share your thoughts on how students in Zurich can contribute to combating climate change in their daily lives. A previous survey found that 96% of students believe climate change is a global threat.&nbsp;<\/strong><br>\n<br>\nYour response will be added to a database of <strong>${e:\/\/Field\/InstagramComp}<\/strong>. We will use this database in a follow-up survey with ETH\/UZH students, where each post has a 1 in 20 chance of being randomly selected. In this follow-up survey, recipients will carefully read your post and share their opinion about both you and your post. They will be informed that the post is drawn from a database of <strong>${e:\/\/Field\/InstagramComp}<\/strong>.<br>\n<br>\nAlong with your post, we will share that the post is written by ${e:\/\/Field\/FirstNameStore} ${e:\/\/Field\/InstaTag} from ${e:\/\/Field\/UniversityStore} (${e:\/\/Field\/FacultyStore}, ${e:\/\/Field\/GradYearStore}). ${e:\/\/Field\/AIIdentifiedExplain}<br>\n<br>\nWrite your post in the space below. You may consider including personal anecdotes to make your response more engaging, but this is entirely optional.&nbsp;","DefaultChoices":false,"QuestionType":"DB","Selector":"GRB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"We have two writing tasks for you. For the first task, we invite you to write a post on the follo...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SubSelector":"WTXB","Graphics":"IM_3KquqTTKKP8a64m","GraphicsDescription":"Wname","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">TreatSignaling<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> Identified <\/span>","LeftOperand":"TreatSignaling","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"Identified","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"QuestionText_Unsafe":"We invite you to write a post on the following topic: <b>\"Do you think Switzerland should accept more refugees? Why or why not?\"<\/b><br>\n<br>\nYour response will be included in a database to help create Instagram ads <b>targeted at thousands of progressive university students in Zurich<\/b>. The database consists of <strong>${e:\/\/Field\/InstagramComp}<\/strong>.<br>\n<br>\nPosts will be randomly selected from this database, with each post having a 1 in 20 chance of being chosen. If your post is selected, it will be featured as shown below. <strong>${e:\/\/Field\/InstaTagExplain}<\/strong><br>\n<br>\n${e:\/\/Field\/AIIdentifiedExplain}<br>\n<br>\nCaption: Join the conversation! Full disclosure: the quote from this post<b> <\/b>is randomly selected from a database consisting of <b>${e:\/\/Field\/InstagramComp}. ${e:\/\/Field\/InstaTag}<\/b><br>\n<br>\n<br>\n&nbsp;","DataExportTag":"SignalingIden1 ","QuestionID":"QID249"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID250","SecondaryAttribute":"We have two writing tasks for you. For the first task, we invite you to write a post on the follo...","TertiaryAttribute":null,"Payload":{"QuestionText":"We have two writing tasks for you.<br \/>\n<br \/>\nFor the first task, we invite you to write a post on the following topic:&nbsp;<br \/>\n<br \/>\n<strong>Share your thoughts on how students in Zurich can contribute to combating climate change in their daily lives. A previous survey found that 96% of students believe climate change is a global threat.&nbsp;<\/strong><br \/>\n<br \/>\nYour response will be added to a database of <strong>${e:\/\/Field\/InstagramComp}<\/strong>. We will use this database in a follow-up survey with ETH\/UZH students, where each post has a 1 in 20 chance of being randomly selected. In this follow-up survey, recipients will carefully read your post and share their opinion about both you and your post. They will be informed that the post is drawn from a database of <strong>${e:\/\/Field\/InstagramComp}<\/strong>.<br \/>\n<br \/>\nAlong with your post, we will share that the post is written by a student from ${e:\/\/Field\/UniversityStore} (${e:\/\/Field\/FacultyStore}, ${e:\/\/Field\/GradYearStore}).<br \/>\n<br \/>\nWrite your post in the space below. You may consider including personal anecdotes to make your response more engaging, but this is entirely optional.&nbsp;","DefaultChoices":false,"QuestionType":"DB","Selector":"GRB","SubSelector":"WTXB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"We have two writing tasks for you. For the first task, we invite you to write a post on the follo...","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">TreatSignaling<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> Anonymous <\/span>","LeftOperand":"TreatSignaling","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"Anonymous","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"Graphics":"IM_78sfdAyAfk56veS","GraphicsDescription":"Noname","QuestionText_Unsafe":"We invite you to write a post on the following topic: <b>\"Do you think Switzerland should accept more refugees? Why or why not?\"<\/b><br>\n<br>\nYour response will be included in a database to help create Instagram ads<b> targeted at thousands of progressive university students in Zurich<\/b>. The database consists of <strong>${e:\/\/Field\/InstagramComp}<\/strong>.<br>\n<br>\nPosts will be randomly selected from this database, with each post having a 1 in 20 chance of being chosen. If your post is selected, it will be featured as shown below.&nbsp;<br>\n<br>\nCaption: Join the conversation! Full disclosure: the quote from this post is randomly selected from a database consisting of<b> ${e:\/\/Field\/InstagramComp}. <\/b><br>\n&nbsp;","DataExportTag":"SignalingAnon1","QuestionID":"QID250"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID251","SecondaryAttribute":"Instead of the quote above, we will show \"Your Quote\"\u2013 ${e:\/\/Field\/FirstNameStore} from ...","TertiaryAttribute":null,"Payload":{"QuestionText":"Instead of the quote above, we will show \"Your Quote\"\u2013 ${e:\/\/Field\/FirstNameStore} from ${e:\/\/Field\/UniversityStore} (${e:\/\/Field\/FacultyStore}, ${e:\/\/Field\/GradYearStore})\u201d","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instead of the quote above, we will show \"Your Quote\"\u2013 ${e:\/\/Field\/FirstNameStore} from ...","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">TreatSignaling<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> Identified <\/span>","LeftOperand":"TreatSignaling","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"Identified","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"Instead of 