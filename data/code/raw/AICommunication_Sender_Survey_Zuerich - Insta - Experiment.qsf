crat or an independent?","QuestionID":"QID1216739368"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID1216739369","SecondaryAttribute":"Think about the past three weeks. On average, how much time did you spend on social media per day...","TertiaryAttribute":null,"Payload":{"QuestionText":"Think about the past three weeks. On average, how much time did you spend on social media per day? <br><br>Social media includes apps like Facebook, Instagram, Snapchat, TikTok, Twitter, LinkedIn, Reddit, and YouTube. Please indicate your usage across all apps. <br><br>You do not need to round to the whole hour as decimals are allowed. <br>","DefaultChoices":false,"DataExportTag":"PerceivedUse ","QuestionID":"QID1216739369","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":227,"InputHeight":29},"QuestionDescription":"Think about the past three weeks. On average, how much time did you spend on social media per day...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"ContentType","MinChars":"1","ContentType":"ValidNumber","ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip","ValidNumber":{"Min":"0","Max":"20","NumDecimals":"2"}}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\/*Place Your Javascript Below This Line*\/\n\nvar inputs = $(this.getQuestionContainer()).select('input[type=\"text\"]');\n\nfor (var i = 0; i < inputs.length; i++) {\nvar input = inputs[i];\n$(input).insert({after: ' hour(s)'});\n}\n\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\