and explore new interests or hobbies"},"6":{"Display":"To promote my personal brand or business."},"7":{"Display":"Other"}},"ChoiceOrder":[1,2,3,4,5,6,7],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID78","DisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1216739369\/ChoiceTextEntryValue","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Think about the past three weeks. On average, how much time did you spend on social media per day? Social media includes apps like Facebook, Instagram, Snapchat, TikTok, Twitter, LinkedIn, and Redd...<\/span> <span class=\"LeftOpDesc\">Text Response<\/span> <span class=\"OpDesc\">Is Greater Than<\/span> <span class=\"RightOpDesc\"> 0 <\/span>","LeftOperand":"q:\/\/QID1216739369\/ChoiceTextEntryValue","LogicType":"Question","Operator":"GreaterThan","QuestionID":"QID1216739369","QuestionIDFromLocator":"QID1216739369","QuestionIsInLoop":"no","RightOperand":"0","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID79","SecondaryAttribute":"How would you describe your engagement with social media?","TertiaryAttribute":null,"Payload":{"QuestionText":"How would you describe your engagement with social media?<br>","DataExportTag":"UseStyle","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How would you describe your engagement with social media?","Choices":{"1":{"Display":"I actively post, share, and interact with content regularly."},"2":{"Display":"I mainly consume content without actively participating or sharing my own."},"3":{"Display":"I have a balanced approach, both posting and consuming content."}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","F