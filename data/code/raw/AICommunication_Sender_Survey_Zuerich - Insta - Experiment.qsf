our lottery, we wil...","Choices":{"1":{"Display":"${q:\/\/QID1216739362\/ChoiceTextEntryValue} from ${q:\/\/QID1216739363\/ChoiceTextEntryValue} won the lottery"},"2":{"Display":"A participant from ${q:\/\/QID1216739363\/ChoiceTextEntryValue} won the lottery"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID83"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID84","SecondaryAttribute":"On social media, what are your preferences for interacting with humans, traditional rule-based bo...","TertiaryAttribute":null,"Payload":{"QuestionText":"On social media, what are your preferences for interacting with humans, traditional rule-based bots, or conversational Gen-AI bots?","DefaultChoices":false,"DataExportTag":"BotSocialMedia","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"On social media, what are your preferences for interacting with humans, traditional rule-based bo...","Choices":{"1":{"Display":"Humans"},"2":{"Display":"Traditional rule-based bots"},"3":{"Display":"Conversational Gen-AI bots"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":6,"Answers":{"1":{"Display":"1 (Strongly Prefer Not)"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5 (Strongly Prefer)"}},"AnswerOrder":[1,2,3,4,5],"ChoiceDataExportTags":false,"QuestionID":"QID84"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID85","SecondaryAttribute":"How comfortable are you with the use of conversational Gen-AI bots as a replacement for tradition...","TertiaryAttribute":null,"Payload":{"QuestionText":"How comfortable are you with the use of conversational Gen-AI bots as a replacement for traditional rule-based bots in customer service?<br>","DataExportTag":"BotComfort","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How comfortable are you with the use of conversational Gen-AI bots as a replacement for tradition...","Choices":{"1":{"Display":"Very uncomfortable"},"2":{"Display":"Somewhat uncomfortable"},"3":{"Display":"Neutral"},"4":{"Display":"Somewhat comfortable"},"5":{"Display":"Very comfortable"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID85"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID86","SecondaryAttribute":"How comfortable are you with the use of conversational Gen-AI bots as a replacement for human use...","TertiaryAttribute":null,"Payload":{"QuestionText":"How comfortable are you with the use of conversational Gen-AI bots as a replacement for human users in customer service?<br>","DataExportTag":"AIComfort ","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How comfortable are you with the use of conversational Gen-AI bots as a replacement for human use...","Choices":{"1":{"Display":"Very uncomfortable"},"2":{"Display":"Somewhat uncomfortable"},"3":{"Display":"Neutral"},"4":{"Display":"Somewhat comfortable"},"5":{"Display":"Very comfortable"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID86"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID87","SecondaryAttribute":"If you had to guess, what would you say our research project is about?","TertiaryAttribute":null,"Payload":{"QuestionText":"If you had to guess, what would you say our research project is about?<br>","DefaultChoices":false,"DataExportTag":"StudyPurposeLong","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If you had to guess, what would you say our research project is about?","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID87"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID88","SecondaryAttribute":"We will invite some participants to a Follow-up Study. In this Follow-up Study, you will be asked...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>We will invite some participants to a Follow-up Study. In this Follow-up Study, you will be asked to write 10 posts, similar to the one you would write on social media, with 10 different randomly selected topic prompts. Similar to the task you just completed, we will randomly select one of your posts and send it to three recipients consisting of <strong>${e:\/\/Field\/TreatCompLong}<\/strong>.<\/p>\n\n<p>&nbsp;<\/p>\n\n<p>We are trying to determine fair compensation for participation. What is the minimum amount you would accept as compensation for participating in this Follow-up Study? This amount should be the lowest you would be willing to accept to ensure your participation.<\/p>\n\n<p>&nbsp;<\/p>\n<strong>It is in your best interest to state carefully and honestly the true minimum amount you would accept.<\/strong> At the beginning of this survey, the computer has already randomly determined an amount to offer you to participate in this Follow-up Study. If this offer is equal to or higher than the minimum amount you specified, you will be invited to participate in the study and will receive the randomly determined amount as compensation. If the offer is lower than your specified amount, you will not be invited to participate. Overstating may result in not being selected, while understating may result in receiving less compensation than you deem acceptable.<br>\n<br>\n<br>\n&nbsp;","DefaultChoices":false,"DataExportTag":"StudyValue","QuestionID":"QID88","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":281,"InputHeight":29},"QuestionDescription":"We will invite some participants to a Follow-up Study. In this Follow-up Study, you will be asked...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"ContentType","MinChars":"1","ContentType":"ValidNumber","ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip","ValidNumber":{"Min":"0","Max":"2000","NumDecimals":""}}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function(){\n\n});\n\nQualtrics.SurveyEngine.addOnload(function()\n{\n\/*Place Your Javascript Below This Line*\/\n\nvar inputs = $(this.getQuestionContainer()).select('input[type=\"text\"]');\n\nfor (var i = 0; i < inputs.length; i++) {\nvar input = inputs[i];\n$(input).insert({before: '$'});\n}\n\n\n});"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID89","SecondaryAttribute":"How important is it to you that the recipients of the post perceive you positively?","TertiaryAttribute":null,"Payload":{"QuestionText":"How important is it to you that the recipients of the post perceive you positively?<br>","DefaultChoices":false,"DataExportTag":"SignalValue","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"importance","Type":"likert","Reverse":false}}},"QuestionDescription":"How important is it to you that the recipients of the post perceive you positively?","Choices":{"1":{"Display":"Not important at all"},"2":{"Display":"Slightly important"},"3":{"Display":"Moderately important"},"4":{"Display":"Very important"},"5":{"Display":"Extremely important"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID89"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID90","SecondaryAttribute":"How interested are you in viewing the recipient's reactions and replies to your messages?","TertiaryAttribute":null,"Payload":{"QuestionText":"How interested are you in viewing the recipient's reactions and replies to your messages?<br>","DefaultChoices":false,"DataExportTag":"InteractionValue","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How interested are you in viewing the recipient's reactions and replies to your messages?","Choices":{"1":{"Display":"Not at all interested"},"2":{"Display":"Slightly interested"},"3":{"Display":"Moderately interested"},"4":{"Display":"Very interested"},"5":{"Display":"Extremely interested"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID90"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID91","SecondaryAttribute":"What is your expectation regarding the quality of replies you will receive?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your expectation regarding the quality of replies you will receive?<br>","DataExportTag":"QualityExpect","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your expectation regarding the quality of replies you will receive?","Choices":{"1":{"Display":"Very low"},"2":{"Display":"Low"},"3":{"Display":"Moderate"},"4":{"Display":"High"},"5":{"Display":"Very high"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID91"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID92","SecondaryAttribute":"Which of the following emojis would you react with if you saw this post on your social media time...","TertiaryAttribute":null,"Payload":{"QuestionText":"Which of the following emojis would you react with if you saw this post on your social media timeline, if any?<br>","DataExportTag":"EmojiReact","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which of the following emojis would you react with if you saw this post on your social media time...","Choices":{"1":{"Display":"Like"},"2":{"Display":"Love"},"3":{"Display":"Care"},"4":{"Display":"Haha"},"5":{"Display":"Wow"},"6":{"Display":"Sad"},"7":{"Display":"Angry"},"8":{"Display":"I would not react to this post. "}},"ChoiceOrder":[1,2,3,4,5,6,7,8],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID92"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttrib