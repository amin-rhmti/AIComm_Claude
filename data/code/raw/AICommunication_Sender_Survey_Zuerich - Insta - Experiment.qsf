ctedChoices}) from ${q:\/\/QID1216739363\/ChoiceTextEntryValue} wrote the following post<br \/>\n<img src=\"${q:\/\/QID77\/UploadedFileLink}\" \/><br \/>\n<br \/>\n&nbsp; [your post here]<br \/>\n<br \/>\n<br \/>\nWhich of the following emojis would you react with if you saw this post on your social media timeline, if any?<br \/>\nLike<br \/>\nLove<br \/>\nCare<br \/>\nHaha<br \/>\nWow<br \/>\nSad<br \/>\nAngry<br \/>\nI would not react to this post.<br \/>\n<br \/>\nIf you feel inclined to respond, what would your reply be? Please write your response below as you would post it on social media.","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\tjQuery(\"#\"+this.questionId+\" .InputText:eq(0)\").on(\"cut copy paste\",function(e) {\n   e.preventDefault();\n  });\n\t\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"ExplainIdentified","QuestionID":"QID99","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"We will ask you on the next page to write a post, similar to what you would write on social media...","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span>  <span class=\"LeftOpDesc\">TreatIdentity<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 1 <\/span>","LeftOperand":"TreatIdentity","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"1","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"STAT","PrimaryAttribute":"Survey Statistics","Seco