\t\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"ExplainTask2","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The message sent to the recipient will look as follows: ${e:\/\/Field\/TreatIdentityLong} (aged ...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID133"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID134","SecondaryAttribute":"Would you like to complete this writing task for a chance to earn the Like Bonus?","TertiaryAttribute":null,"Payload":{"QuestionText":"Would you like to complete this writing task for a chance to earn the Like Bonus?","DataExportTag":"TaskComplete","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Would you like to complete this writing task for a chance to earn the Like Bonus?","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID134"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID135","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionText_Unsafe":"Timing","DataExportTag":"Q135","QuestionID":"QID135"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID136","SecondaryAttribute":"We would like to provide additional details about what the Democrat Prolific recipient will see....","TertiaryAttribute":null,"Payload":{"QuestionText":"We would like to provide additional details about what the Democrat Prolific recipient will see.<br>\n<br>\nThe recipient will view one post randomly chosen from a pool of five posts, which includes your post and four others. The recipient will be informed that the post is randomly chosen from a pool of five posts from <strong>${e:\/\/Field\/TreatCompLong},<\/strong> but they will not be told who wrote which post.<br>\n<br>\n<strong>${e:\/\/Field\/ProbExplain}<\/strong><br>\n<br>\n${e:\/\/Field\/GenAIAction} ${e:\/\/Field\/BotAction}","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\tjQuery(\"#\"+this.questionId+\" .InputText:eq(0)\").on(\"cut copy paste\",function(e) {\n   e.preventDefault();\n  });\n\t\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"We would like to provide additional details about what the Democrat Prolific recipient will see....","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>The post will be sent to 3 recipients consisting of ${e:\/\/Field\/TreatCompLong}. <\/strong>Each recipient will independently have the opportunity to react and reply to your post. You will be notified of those reactions and replies by Prolific message.<br \/>\n<br \/>\nYou now have an opportunity to earn a Like Bonus by completing a writing task in a single session.<br \/>\n<br \/>\nYou will be asked write a post, similar to what you would write on social media, on the following topic:<br \/>\n<br \/>\n<strong>${e:\/\/Field\/WritingTaskPrompt}<\/strong><br \/>\n<br \/>\nA computer will randomly select a fraction of participants to be eligible for the Like Bonus. If selected, your post will be shared with a Democrat recipient on Prolific. They will be asked how they would react if they saw your post on their social media timeline.<br \/>\n<br \/>\nThe Like Bonus will be paid based on the recipient&rsquo;s response:<br \/>\nLike: If the recipient likes your post, you will earn a $1 bonus.<br \/>\nNo reaction: If the recipient does not react to your post, you will earn a $0.50 bonus.<br \/>\nDislike: If the recipient dislikes your post, no bonus will be awarded.<br \/>\n<br \/>\nThe recipient does not know that their response may result in a bonus for you. Revealing this information to the recipient will disqualify you from receiving the Like Bonus.","DataExportTag":"ExplainTaskRandom","QuestionID":"QID136"}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID137","SecondaryAttribute":"Please write a post, similar to what you would write on social media, on the following topic: ...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please write a post, similar to what you would write on social media, on the following topic:<br>\n<br>\n<strong>${e:\/\/Field\/WritingTaskPrompt}<\/strong><br>\n<br>\nIf selected for the Like Bonus, your post will be shared with a Democrat recipient on Prolific. You will receive a $1 bonus if the recipient likes your post, a $0.50 bonus if there is no reaction, and no bonus if the recipient dislikes your post.","DefaultChoices":false,"DataExportTag":"WritingTaskLike","QuestionID":"QID137","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please write a post, similar to what you would write on social media, on the following topic: ...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID138","SecondaryAttribute":"In order to facilitate our research, we are interested in knowing certain factors about you. Spec...","TertiaryAttribute":null,"Payload":{"QuestionText":"In order to facilitate our research, we are interested in knowing certain factors about you. Specifically, we are interested in whether you actually take the time to read the directions; if not, then the data we collect based on your responses will be invalid. So, in order to demonstrate that you have read the instructions, please answer the following question:<br><br>The recipient will view one post randomly chosen from a pool of five posts. How many of these posts are written by humans?\n<br>","DefaultChoices":false,"DataExportTag":"AttnChckRandom","QuestionID":"QID138","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In order to facilitate our research, we are interested in knowing certain factors about you. Spec...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"ContentType","MinChars":"1","ContentType":"ValidNumber","ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip","ValidNumber":{"Min":"","Max":"","NumDecimals":""}}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID139","SecondaryAttribute":"You said that\u00a0${q:\/\/QID138\/ChoiceTextEntryValue} out of the five posts are written by humans. Tha..","TertiaryAttribute":null,"Payload":{"QuestionText":"You said that&nbsp;${q:\/\/QID138\/ChoiceTextEntryValue} out of the five posts are written by humans. That is <strong>incorrect<\/strong>.<br>\n<br>\nThe recipient will view one post randomly chosen from a pool of five posts. Apart from yours, the four other posts are from <strong>${e:\/\/Field\/TreatCompOthers}<\/strong>.<br>\n<br>\nThe recipient will be informed that the post is randomly chosen from a pool of five posts from&nbsp;<strong>${e:\/\/Field\/TreatCompLong},<\/strong> but they will not be told who wrote which post.","DefaultChoices":false,"DataExportTag":"AttnChckRandomIncorr","QuestionID":"QID139","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You said that\u00a0${q:\/\/QID138\/ChoiceTextEntryValue} out of the five posts are written by humans. Tha...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_7POJUFEI0NouVhk","Element":"SQ","PrimaryAttribute":"QID140","SecondaryAttribute":"You said that\u00a0${q:\/\/QID138\/ChoiceTextEntryValue} out of the five posts are written by humans.\u00a0Tha.","TertiaryAttribute":null,"Payload":{"QuestionText":"You said that&nbsp;${q:\/\/QID138\/ChoiceTextEntryValue} out of the five posts are written by humans.&nbsp;That is <strong>correct<\/strong>.<br>\n<br>\nThe recipient will view one post randomly chosen from a pool of five posts. Apart from yours, the four other posts are from <strong>${e:\/\/Field\/TreatCompOthers}<\/strong>.<br>\n<br>\nThe recipient will be informed that the post is randomly chosen from a pool of five posts from&nbsp;<strong>${e:\/\/Field\/TreatCompLong},<\/strong> but they will not be told who wrote which post.","DefaultChoices":false,"DataExportTag":"AttnChckRandomCorr","QuestionType":"DB","Selector